{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/run",
      "destination": "/run/",
      "permanent": false
    },
    {
      "source": "/code",
      "destination": "/code/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/run/",
      "destination": "https://jjoaorunner.vercel.app/"
    },
    {
      "source": "/run/:path*",
      "destination": "https://jjoaorunner.vercel.app/:path*"
    },
    {
      "source": "/code/",
      "destination": "https://jjoaocode.vercel.app/"
    },
    {
      "source": "/code/:path*",
      "destination": "https://jjoaocode.vercel.app/:path*"
    }
  ]
}